# Exemplo de configuração para os ETLs (Cartola FC e OpenF1)
# Copie para .env e ajuste conforme necessário.

MONGO_URI=mongodb://localhost:27017

# Usado pelo cartola_etl.py (o f1_data_collector.py usa "openf1_data" fixo, conforme o PDF)
MONGO_DB_NAME=cartola_fc_db

# Nível de log: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO